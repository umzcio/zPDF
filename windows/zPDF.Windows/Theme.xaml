<!-- zPDF's design tokens, matching the Mac app (zPDF/Utilities/DesignTokens.swift):
     accent, muted text, hairlines, bars, surfaces and the page canvas, in light, dark and
     high contrast. Windows' own accent is set to zPDF blue so native controls match. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="ZAccentColor">#0059BA</Color>
            <Color x:Key="SystemAccentColor">#0059BA</Color>
            <Color x:Key="SystemAccentColorLight1">#1A6FC9</Color>
            <Color x:Key="SystemAccentColorLight2">#3D86D6</Color>
            <Color x:Key="SystemAccentColorLight3">#6BA3E2</Color>
            <Color x:Key="SystemAccentColorDark1">#004C9E</Color>
            <Color x:Key="SystemAccentColorDark2">#003F87</Color>
            <Color x:Key="SystemAccentColorDark3">#00316A</Color>
            <SolidColorBrush x:Key="ZAccent" Color="#0059BA" />
            <SolidColorBrush x:Key="ZAccentTint" Color="#1F0059BA" />
            <SolidColorBrush x:Key="ZMuted" Color="#595959" />
            <SolidColorBrush x:Key="ZText" Color="#1D1D1F" />
            <SolidColorBrush x:Key="ZHairline" Color="#1A000000" />
            <SolidColorBrush x:Key="ZBar" Color="#F6F6F7" />
            <SolidColorBrush x:Key="ZSidebar" Color="#F0F0F3" />
            <SolidColorBrush x:Key="ZSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ZInset" Color="#0D000000" />
            <SolidColorBrush x:Key="ZWindow" Color="#ECECEE" />
            <SolidColorBrush x:Key="ZCanvas" Color="#E4E4E7" />
            <SolidColorBrush x:Key="ZStar" Color="#875100" />
            <SolidColorBrush x:Key="ZOnAccent" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ZAccentColor">#64ACFF</Color>
            <Color x:Key="SystemAccentColor">#0059BA</Color>
            <Color x:Key="SystemAccentColorLight1">#3D86D6</Color>
            <Color x:Key="SystemAccentColorLight2">#64ACFF</Color>
            <Color x:Key="SystemAccentColorLight3">#A8D1FF</Color>
            <Color x:Key="SystemAccentColorDark1">#004C9E</Color>
            <Color x:Key="SystemAccentColorDark2">#003F87</Color>
            <Color x:Key="SystemAccentColorDark3">#00316A</Color>
            <SolidColorBrush x:Key="ZAccent" Color="#64ACFF" />
            <SolidColorBrush x:Key="ZAccentTint" Color="#2664ACFF" />
            <SolidColorBrush x:Key="ZMuted" Color="#B8B8B8" />
            <SolidColorBrush x:Key="ZText" Color="#F2F2F2" />
            <SolidColorBrush x:Key="ZHairline" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ZBar" Color="#2A2A2C" />
            <SolidColorBrush x:Key="ZSidebar" Color="#262628" />
            <SolidColorBrush x:Key="ZSurface" Color="#1E1E1F" />
            <SolidColorBrush x:Key="ZInset" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ZWindow" Color="#1F1F21" />
            <SolidColorBrush x:Key="ZCanvas" Color="#181819" />
            <SolidColorBrush x:Key="ZStar" Color="#FFC15E" />
            <SolidColorBrush x:Key="ZOnAccent" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="ZAccentColor">#003F87</Color>
            <SolidColorBrush x:Key="ZAccent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ZAccentTint" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.25" />
            <SolidColorBrush x:Key="ZMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZText" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZHairline" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZBar" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZSidebar" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZInset" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZWindow" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZCanvas" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZStar" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ZOnAccent" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Section labels: 10.5 pt semibold UPPERCASE, muted (Mac PanelSection / "FILES"). -->
    <Style x:Key="ZSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource ZMuted}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="ZPanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Flat icon buttons in bars (Mac: borderless, 28×28, muted until hovered). -->
    <Style x:Key="ZBarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ZBarToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Panel tool tiles (Mac PanelToolButton: icon over a small label, surface fill, hairline). -->
    <Style x:Key="ZTile" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ZSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ZHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="MinHeight" Value="58" />
    </Style>
    <!-- Panel rows (Mac PanelRow: 13 pt muted icon, 12 pt title). -->
    <Style x:Key="ZRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="9,7" />
    </Style>
    <!-- The right-hand panel rail (Mac: 36×36, 16 pt icons, radius 6). -->
    <Style x:Key="ZRailButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
