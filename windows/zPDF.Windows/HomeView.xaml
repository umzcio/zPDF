<UserControl x:Class="zPDF.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Home, as on the Mac (zPDF/Views/Home/HomeView.swift): a Files column (Recent,
         Starred), a greeting, Open File / Combine PDFs, and recent-file cards. -->
    <Grid x:Name="HomeRoot" Background="{ThemeResource ZWindow}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F10" Invoked="MenuBar_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The app's menus on Home too (the Mac's menu bar is always there). -->
        <MenuBar x:Name="HomeMenu" Grid.ColumnSpan="2" Background="{ThemeResource ZBar}" Height="32" Padding="4,0"
                 BorderBrush="{ThemeResource ZHairline}" BorderThickness="0,0,0,1">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="Open…" Click="Open_Click" />
                <MenuFlyoutItem Text="Combine PDFs…" Click="Combine_Click" />
                <MenuFlyoutItem Text="New Window" Tag="newWindow" Click="Command_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Preferences…" Tag="preferences" Click="Command_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="Keyboard Shortcuts" Tag="shortcuts" Click="Command_Click" />
                <MenuFlyoutItem Text="Report a Bug…" Tag="bug" Click="Command_Click" />
                <MenuFlyoutItem Text="Check for Updates…" Tag="updates" Click="Command_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About zPDF" Tag="about" Click="Command_Click" />
            </MenuBarItem>
        </MenuBar>
        <StackPanel Grid.Row="1" Background="{ThemeResource ZSidebar}" Padding="10,16" Spacing="2"
                    BorderBrush="{ThemeResource ZHairline}" BorderThickness="0,0,1,0">
            <StackPanel.Resources>
                <!-- Selected = accent icon on an accent tint (Mac rail / panel tiles), per theme. -->
                <ResourceDictionary>
                  <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemAccentColorDark2}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorDark2}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColorDark2}" Opacity="0.5" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemAccentColorDark2}" Opacity="0.5" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.5" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.5" />
                    </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        </ResourceDictionary>
                  </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </StackPanel.Resources>
            <TextBlock Text="FILES" Style="{StaticResource ZSectionLabel}" Margin="8,0,0,6" />
            <ToggleButton x:Name="RecentFilter" Tag="recent" IsChecked="True" Click="Filter_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Height="30" Padding="8,0" CornerRadius="6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Recent">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81C;" FontSize="13" />
                        <TextBlock Text="Recent" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="RecentCount" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
            </ToggleButton>
            <ToggleButton x:Name="StarredFilter" Tag="starred" Click="Filter_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Height="30" Padding="8,0" CornerRadius="6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Starred">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="13" />
                        <TextBlock Text="Starred" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StarredCount" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
            </ToggleButton>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="36" Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Pick up where you left off, or start something new." FontSize="12.5" Foreground="{ThemeResource ZMuted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Open_Click" AutomationProperties.Name="Open File">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="Open File" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="Combine_Click" Content="Combine PDFs…" FontSize="12.5" />
                </StackPanel>
                <TextBlock x:Name="ListTitle" Text="Recent files" FontSize="14" FontWeight="SemiBold" />
                <GridView x:Name="Cards" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Cards_ItemClick" Padding="0" AutomationProperties.Name="Recent files">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,16,16" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Left" Margin="0,24,0,0">
                    <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{ThemeResource ZMuted}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="EmptyTitle" Text="No files yet" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyDetail" Text="PDFs you open appear here." FontSize="12" Foreground="{ThemeResource ZMuted}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
