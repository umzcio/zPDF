<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>zPDF</RootNamespace>
    <Version>0.1.3</Version>
    <Product>zPDF</Product>
    <ApplicationIcon>zPDF.ico</ApplicationIcon>
    <AssemblyName>zPDF</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build output (any BaseOutputPath) holds the Python runtime, whose Tcl files use .cs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;out/**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs owns Main so the self-test mode can run without starting WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <!-- Same PDFium build as the Mac app's engine (pypdfium2 5.13.0 = 153.0.7999). -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="153.0.7999" />
    <!-- Signature images (typed, drawn, marks) and per-user protection of stored digital IDs. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.*" />
    <!-- Installer and updates (GitHub Releases, "win" channel), like Sparkle on the Mac. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="zPDF.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The bundled engine runtime (windows/scripts/prepare_runtime.py), when prepared.
       Copied after the build rather than as Content, so resource indexing skips it. -->
  <Target Name="CopyEngineRuntime" AfterTargets="Build;Publish" Condition="Exists('..\build\EngineRuntime\python\python.exe')">
    <ItemGroup>
      <EngineRuntimeFile Include="..\build\EngineRuntime\**\*" />
    </ItemGroup>
    <PropertyGroup>
      <EngineRuntimeTarget Condition="'$(PublishDir)' != '' And '$(_IsPublishing)' == 'true'">$(PublishDir)</EngineRuntimeTarget>
      <EngineRuntimeTarget Condition="'$(EngineRuntimeTarget)' == ''">$(OutDir)</EngineRuntimeTarget>
    </PropertyGroup>
    <Copy SourceFiles="@(EngineRuntimeFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(EngineRuntimeFile->'$(EngineRuntimeTarget)EngineRuntime\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
