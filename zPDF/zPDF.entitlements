<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  zPDF.entitlements — sandboxed app.
  User-selected read-write + app-scope bookmarks are required for the
  recents list (RecentFilesStore) to reopen previously chosen files.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- Create PDF from Web Page (user-entered URL), network scanners (Bonjour), and user-enabled RFC 3161 timestamp / OCSP / CRL requests when signing. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Scanning with USB scanners through ImageCaptureCore. -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Sparkle updates in a sandboxed app: its installer launcher/status XPC services. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>app.zpdf.zPDF-spks</string>
		<string>app.zpdf.zPDF-spki</string>
	</array>
</dict>
</plist>
